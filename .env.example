# Project Settings
PROJECT_NAME="Khan Store"
SECRET_KEY="replace_with_a_secure_random_hash_key_for_jwt"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Settings (MySQL)
USE_MYSQL=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DB=khan_store_db
MYSQL_USER=khan_user
MYSQL_PASSWORD=khan_password

# Frontend API URL
NEXT_PUBLIC_API_URL=/api/v1

# Secret Admin Panel Route Path (Obscure Server-Side URL)
ADMIN_PANEL_PATH=khan-sec-manage-x7k9
