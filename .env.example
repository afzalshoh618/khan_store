# ==========================================
# KHAN STORE PREMIUM - ENVIRONMENT VARIABLES
# ==========================================

# Project & Security Settings
PROJECT_NAME="Khan Store Premium"
ENVIRONMENT=production # 'development' or 'production'
SECRET_KEY=change_this_to_a_random_32_character_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Secret Admin Panel obfuscated URL path (e.g. khan-sec-manage-x7k9)
ADMIN_PANEL_PATH=khan-sec-manage-x7k9

# Allowed CORS origins for backend (comma-separated list of allowed domains)
ALLOWED_ORIGINS=https://khan-store.up.railway.app,https://khanstore.uz,http://localhost:3000

# Database Settings (Railway MySQL or external MySQL)
# Note: On Railway, MYSQL_URL is automatically provided by Railway MySQL Plugin
MYSQL_URL=
# Or individual MySQL credentials for local development / custom server:
USE_MYSQL=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=khan_store_db
MYSQL_USER=khan_user
MYSQL_PASSWORD=khan_password

# Telegram Bot Notifications (Optional - for order alerts)
TELEGRAM_BOT_TOKEN=8737400032:AAHtkMxXhw27Pmh-wSsRSisSIYYGSL6e1tg
TELEGRAM_CHAT_ID=-1004299963020

# Cloudflare R2 Object Storage (S3 API compatible product photo storage)
# If left empty, backend automatically falls back to local disk storage (/static/uploads/)
USE_R2=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=khan-store-uploads
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# Frontend API Endpoint Configuration
NEXT_PUBLIC_API_URL=/api/v1
# Internal Docker/Railway backend routing (for Next.js SSR rewrites)
BACKEND_INTERNAL_URL=http://localhost:8000

